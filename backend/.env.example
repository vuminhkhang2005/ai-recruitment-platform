# Copy this file to backend/.env (git-ignored) and fill in the values.
# Spring Boot loads it through `spring.config.import: optional:file:.env[.properties]`.
# Real environment variables (e.g. in docker-compose or the hosting platform) always take precedence.

# --- Database ---
DB_URL=jdbc:mysql://localhost:3306/ai_recruitment_db?useSSL=false&serverTimezone=UTC&characterEncoding=UTF-8&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# --- JWT (hex string, at least 64 characters) ---
JWT_SECRET=replace_with_random_hex_64_chars
JWT_COOKIE_SECURE=false

# --- OAuth2 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# true = in-app OAuth dialog may sign in with any e-mail WITHOUT verification (local dev / tests only)
OAUTH2_SANDBOX_ENABLED=false

# --- AI engine (FastAPI + PyTorch) ---
AI_ENGINE_URL=http://localhost:8000

# --- Frontend URL used in e-mail links ---
APP_FRONTEND_URL=http://localhost:5173

# --- Mail relay: Google Apps Script (recommended free option) ---
GOOGLE_SCRIPT_MAIL_URL=
GOOGLE_SCRIPT_MAIL_SECRET=
# Optional alternatives
BREVO_API_KEY=
RESEND_API_KEY=
