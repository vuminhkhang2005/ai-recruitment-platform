      "name": "Jobs",
      "item": [
        {
          "name": "1. Search Jobs (Default Pagination)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/jobs?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "jobs"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "2. Search Jobs by Keyword (React)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/jobs?keyword=React",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "jobs"],
              "query": [
                { "key": "keyword", "value": "React" }
              ]
            }
          }
        },
        {
          "name": "3. Filter Jobs by Location City",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/jobs?city=TP. H%E1%BB%93 Ch%C3%AD Minh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "jobs"],
              "query": [
                { "key": "city", "value": "TP. Hồ Chí Minh" }
              ]
            }
          }
        },
        {
          "name": "4. Filter Jobs by Salary Range (30M - 60M)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/jobs?minSalary=30000000&maxSalary=60000000",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "jobs"],
              "query": [
                { "key": "minSalary", "value": "30000000" },
                { "key": "maxSalary", "value": "60000000" }
              ]
            }
          }
        },
        {
          "name": "5. Get Job Details by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/jobs/{{jobId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "jobs", "{{jobId}}"]
            }
          }
        },
        {
          "name": "6. Get Featured Jobs (Homepage)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
