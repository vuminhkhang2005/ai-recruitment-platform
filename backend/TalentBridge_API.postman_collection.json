              "mode": "raw",
              "raw": "{\n  \"title\": \"Principal AI Engineer (LLM & Agentic AI)\",\n  \"companyId\": 2,\n  \"description\": \"Xây dựng hệ thống agentic AI và mô hình ngôn ngữ lớn tại TalentBridge.\",\n  \"requirements\": \"Tối thiểu 5 năm kinh nghiệm về Python, PyTorch, LangChain, Transformers.\",\n  \"benefits\": \"Lương tháng 13, thưởng hiệu suất, cổ phiếu ESOP, bảo hiểm cao cấp.\",\n  \"jobType\": \"HYBRID\",\n  \"expLevel\": \"LEAD\",\n  \"minSalary\": 60000000,\n  \"maxSalary\": 100000000,\n  \"currency\": \"VND\",\n  \"locationCity\": \"TP. Hồ Chí Minh\",\n  \"locationAddress\": \"Z06 Đường số 13, KCX Tân Thuận, Quận 7\",\n  \"skills\": [\"Python\", \"PyTorch\", \"LLM\", \"Docker\", \"Kubernetes\"]\n}"
            },
