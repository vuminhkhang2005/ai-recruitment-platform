# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE: AI-TALENTBRIDGE PLATFORM
# ==============================================================================

NODE_ENV=development
PORT=5000

# ------------------------------------------------------------------------------
# DATABASE CONNECTION (MySQL 8.0+)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_recruitment_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_CHARSET=utf8mb4

DATABASE_URL="mysql://root:your_mysql_password@localhost:3306/ai_recruitment_db?charset=utf8mb4"
DOTNET_CONNECTION_STRING="Server=localhost;Port=3306;Database=ai_recruitment_db;Uid=root;Pwd=your_mysql_password;Charset=utf8mb4;TreatTinyAsBoolean=true;"

# ------------------------------------------------------------------------------
# REDIS CACHE & QUEUE
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# JWT AUTHENTICATION
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace_with_secure_random_jwt_secret_key
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=replace_with_secure_random_refresh_secret_key
JWT_REFRESH_EXPIRATION=7d

# ------------------------------------------------------------------------------
# AI LLM PROVIDERS (Google Gemini 1.5)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-1.5-flash
GEMINI_MODEL_REASONING=gemini-1.5-pro

# ------------------------------------------------------------------------------
# STORAGE (MinIO / S3)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_BUCKET_NAME=talentbridge-cv-storage
